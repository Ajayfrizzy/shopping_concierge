# Safe server defaults; empty fields are placeholders, not credentials.
# Copy to root .env only when overriding defaults. Never commit real values.
NODE_ENV=development
# Hosting: NODE_ENV=production and API_HOST=0.0.0.0.
# Platform-injected PORT takes precedence; do not hardcode it here.
API_PORT=4000
API_HOST=127.0.0.1
# memory remains the credential-free local default. postgres requires s3.
PERSISTENCE_MODE=memory
OBJECT_STORAGE_MODE=memory
DATABASE_URL=
# Optional database-only exception: sslmode=require plus false keeps TLS but skips certificate verification.
# Omit for normal verified connections (e.g. sslmode=verify-full). Never disables global TLS.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Required for postgres/s3 mode: DATABASE_URL, S3_ENDPOINT, S3_REGION, S3_BUCKET,
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY. See docs/PERSISTENCE.md.
# Optional project prefix for approved VTO asset discovery; does not rewrite stored upload keys.
S3_ASSET_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional verified email access; disabled until an SMTP adapter is configured.
EMAIL_AUTH_ENABLED=false
SMTP_URL=
EMAIL_FROM=
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=low
YOUCAM_API_KEY=
YOUCAM_BASE_URL=
USE_MOCK_LLM=true
USE_MOCK_YOUCAM=true

# Optional live VTO: leave USE_MOCK_YOUCAM=true for ordinary development.
# Server-only exact HTTPS host allowlists, verified against account upload/output URLs.
# YOUCAM_UPLOAD_HOSTS=
# YOUCAM_ASSET_HOSTS=

# Live validation only: existing append-only server ledger; maximum eight render reservations.
# Initialize once, preserve across restarts/retries, never reset to bypass the limit.
# YOUCAM_USAGE_LEDGER=artifacts/youcam-render-reservations.jsonl
# Path is illustrative: live mode requires an existing validated append-only ledger.

# Live judge deployment: postgres reuses DATABASE_URL and DATABASE_SSL_REJECT_UNAUTHORIZED.
# Apply migration 004 explicitly before startup. Its five historical renders remain charged.
# File mode remains the local validation default; YOUCAM_USAGE_LEDGER is file-mode only.
YOUCAM_LEDGER_MODE=file
YOUCAM_MAX_REQUESTS=8
YOUCAM_MAX_UNITS=8
# PostgreSQL ceilings must match the persisted budget row; changing env alone never resets usage.
