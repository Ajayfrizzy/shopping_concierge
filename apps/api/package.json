{
  "name": "@youcam/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/runtime/server.js",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=../../.env src/persistence/migrate.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@youcam/agent": "*",
    "@youcam/catalog": "*",
    "@youcam/shared": "*",
    "@youcam/testing": "*",
    "fastify": "^5.12.6",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "esbuild": "0.28.2"
  }
}
