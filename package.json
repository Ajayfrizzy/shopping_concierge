{
  "name": "shopping-concierge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,mobile \"npm run dev:api\" \"npm run dev:mobile\"",
    "dev:api": "npm run dev -w @youcam/api",
    "dev:mobile": "npm run dev -w @youcam/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w @youcam/mobile",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "export:android": "npm run export:android -w @youcam/mobile",
    "android:build": "npm run android -w @youcam/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11",
    "vite": "^7.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "overrides": {
    "vite": "$vite",
    "react": "$react",
    "react-dom": "$react-dom",
    "react-native": "0.86.3",
    "react-native-reanimated": "$react-native-reanimated",
    "react-native-worklets": "$react-native-worklets"
  }
}
