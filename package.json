{
  "name": "shopping-concierge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,mobile \"npm run dev:api\" \"npm run dev:mobile\"",
    "dev:api": "npm run dev -w @youcam/api",
    "dev:mobile": "npm run dev -w @youcam/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w @youcam/mobile",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "export:android": "npm run export:android -w @youcam/mobile",
    "android:build": "npm run android -w @youcam/mobile",
    "test:integration": "M5_INTEGRATION=1 vitest run tests/persistence-postgres.test.ts tests/youcam-ledger.test.ts tests/runtime-accounting.test.ts",
    "infra:local": "docker compose -f infra/compose.local.yml up -d --wait",
    "db:migrate": "npm run db:migrate -w @youcam/api --",
    "dev:persistent": "node --env-file=infra/local.env.example --import tsx apps/api/src/server.ts",
    "db:local": "node --env-file=infra/local.env.example --import tsx apps/api/src/persistence/migrate.ts --seed-fixtures",
    "verify:mobile-secrets": "node scripts/verify-mobile-secrets.mjs",
    "test:llm:live": "node --env-file-if-exists=apps/api/.env --env-file-if-exists=.env --import tsx scripts/llm-live-regression.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "demo:prepare": "node --import tsx scripts/demo.mts prepare",
    "demo:api": "node --import tsx scripts/demo.mts api",
    "demo:mobile": "node --import tsx scripts/demo.mts mobile",
    "demo:android": "node --import tsx scripts/demo.mts android",
    "credits:report": "node --import tsx scripts/credit-report.mts",
    "build:api": "npm run build -w @youcam/api",
    "start": "npm run start -w @youcam/api",
    "build": "npm run build:api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "$vite",
    "react": "$react",
    "react-dom": "$react-dom",
    "react-native": "0.86.3",
    "react-native-reanimated": "$react-native-reanimated",
    "react-native-worklets": "$react-native-worklets"
  }
}
