# Public local-only test credentials matching compose.local.yml. Never use for deployment.
API_HOST=127.0.0.1
API_PORT=4000
PERSISTENCE_MODE=postgres
OBJECT_STORAGE_MODE=s3
DATABASE_URL=postgresql://concierge_test:local_test_only@127.0.0.1:15432/concierge_test
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=concierge-test
S3_ACCESS_KEY_ID=concierge_test
S3_SECRET_ACCESS_KEY=local_test_only
S3_FORCE_PATH_STYLE=true
EMAIL_AUTH_ENABLED=false
USE_MOCK_LLM=true
USE_MOCK_YOUCAM=true
